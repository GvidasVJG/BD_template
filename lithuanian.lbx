% Nedidelė šablono bibliografijos lokalizacija. Nėra senųjų APA failų priklausomybės.
\ProvidesFile{lithuanian.lbx}[2026/11/01 Lithuanian bibliography strings]
\InheritBibliographyExtras{english}
\DeclareBibliographyStrings{inherit={english},
  bibliography={{Literatūros šaltinių sąrašas}{Literatūros šaltinių sąrašas}},
  references={{Literatūros šaltinių sąrašas}{Literatūros šaltinių sąrašas}},
  and={{ir}{ir}},andothers={{ir kiti}{ir kt\adddot}},
  editor={{redaktorius}{red\adddot}},editors={{redaktoriai}{red\adddot}},
  translator={{vertėjas}{vert\adddot}},translators={{vertėjai}{vert\adddot}},
  page={{puslapis}{p\adddot}},pages={{puslapiai}{p\adddot}},
  volume={{tomas}{t\adddot}},number={{numeris}{nr\adddot}},
  edition={{leidimas}{leid\adddot}},
  urlseen={{žiūrėta}{žiūrėta}},urlfrom={{prieiga per internetą}{prieiga per internetą}},
  in={{iš}{iš}},nodate={{be datos}{b\adddot d\adddot}}}
\endinput
